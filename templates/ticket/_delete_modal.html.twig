{# Delete confirmation modal, suggesting to resolve the ticket instead of deleting it #}
{% set isClosed = ticket.status and ticket.status.closed %}
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">{{ 'Delete Ticket'|trans }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
            </div>
            <div class="modal-body">
                {% if not isClosed %}
                    <div class="alert alert-success d-flex gap-2 mb-3" role="note">
                        <i class="bi bi-check-circle"></i>
                        <div>
                            <strong>{{ 'Is the request handled?'|trans }}</strong><br>
                            {{ 'Mark it as resolved instead: the ticket and its history stay available.'|trans }}
                        </div>
                    </div>
                {% endif %}
                <p>{{ 'Are you sure you want to delete this ticket?'|trans }}</p>
                <p class="mb-0 text-danger">
                    <i class="bi bi-exclamation-triangle"></i>
                    {{ 'Its comments, attachments and logged hours will be deleted as well. This action cannot be undone.'|trans }}
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary me-auto" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                {{ include('ticket/_delete_form.html.twig') }}
                {% if not isClosed %}
                    <form method="post" action="{{ path('app_ticket_resolve', {'organizationSlug': currentOrganization.slug, 'ticketId': ticket.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('resolve' ~ ticket.id) }}">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-lg"></i>
                            {{ 'Mark as resolved'|trans }}
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
</div>
