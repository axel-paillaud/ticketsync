{% extends 'base.html.twig' %}

{% block title %}{{ 'New Ticket'|trans }} - {{ currentOrganization.name }}{% endblock %}

{% block body %}
<div class="container py-4">
    {# Back Button #}
    <div class="mb-3">
        <a href="{{ path('app_ticket_index', {'organizationSlug': currentOrganization.slug}) }}" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            {{ 'Back to Tickets'|trans }}
        </a>
    </div>

    {# Page Header #}
    <div class="mb-4">
        <h1>
            <i class="bi bi-plus-circle text-primary"></i>
            {{ 'Create New Ticket'|trans }}
        </h1>
        <p class="text-muted">
            <i class="bi bi-building"></i>
            {{ currentOrganization.name }}
        </p>
    </div>

    {# Package used beyond tolerance: tell the client before they submit, without blocking #}
    {% set quota = monthly_quota(currentOrganization) %}
    {% if quota and quota.exceeded and not is_granted('ROLE_ADMIN') %}
        <div class="alert alert-info quota-exceeded-notice">
            <i class="bi bi-calendar-event"></i>
            {{ 'This month’s maintenance package has been used: this ticket will be scheduled from {date, date, ::dMMMM}, unless it is urgent.'|trans({
                date: quota.nextMonthStart.timestamp
            }) }}
        </div>
    {% endif %}

    {# Form Card #}
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="bi bi-file-text"></i>
                {{ 'Ticket Information'|trans }}
            </h5>
        </div>
        <div class="card-body">
            {{ include('ticket/_form.html.twig', {'button_label': 'Create Ticket'|trans}) }}
        </div>
    </div>
</div>
{% endblock %}
