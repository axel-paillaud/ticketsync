{#
    Client view of the monthly package.
    The tolerance is never shown: the gauge simply stays full once the package
    is used, and a neutral notice only appears beyond the tolerance.
    Expects: quota (App\Model\MonthlyQuota)
#}
<div class="card mb-4 quota-gauge" data-quota-state="{{ quota.state.value }}">
    <div class="card-body py-3">
        <div class="d-flex justify-content-between align-items-baseline mb-2">
            <span class="fw-semibold">
                <i class="bi bi-clock-history text-primary"></i>
                {{ 'Maintenance package – {month, date, ::MMMMyyyy}'|trans({month: quota.monthStart.timestamp}) }}
            </span>
            <span class="text-muted small">
                {{ '{consumed} used out of {included}'|trans({
                    consumed: quota.consumedHours|format_hours,
                    included: quota.monthlyHours|format_hours,
                }) }}
            </span>
        </div>
        <div class="progress" role="progressbar" style="height: 8px;"
             aria-valuenow="{{ min(quota.percent, 100)|round }}" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar" style="width: {{ min(quota.percent, 100)|round(1) }}%"></div>
        </div>

        {% if quota.exceeded %}
            <div class="alert alert-info mt-3 mb-0 quota-exceeded-notice">
                <i class="bi bi-info-circle"></i>
                {{ 'This month’s maintenance package has been used. Your new requests are still recorded and will be handled from {date, date, ::dMMMM}, or sooner if you approve additional hours.'|trans({
                    date: quota.nextMonthStart.timestamp
                }) }}
            </div>
        {% endif %}
    </div>
</div>
